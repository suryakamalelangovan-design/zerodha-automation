# Copy this file to .env and enter your own values locally.
KITE_API_KEY=replace_with_your_kite_connect_api_key
KITE_API_SECRET=replace_with_your_kite_connect_api_secret
KITE_REDIRECT_URL=http://127.0.0.1:8000/callback

# Generate a long random value; example command is in README.md.
SESSION_SECRET=replace_with_a_long_random_secret
COOKIE_SECURE=false
